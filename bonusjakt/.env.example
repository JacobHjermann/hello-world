# Kopier denne filen til .env og fyll inn. Ingen av feltene er påkrevd for å starte;
# uten seats.aero-nøkkel brukes eksempeldata, og kanaler uten oppsett hoppes over.

# Passord for å åpne siden (brukernavn kan være hva som helst). Sett ALLTID dette på en server.
APP_PASSWORD=

# Adressen siden ligger på, brukes som lenke i varslene. F.eks. https://bonusjakt.up.railway.app
PUBLIC_URL=

PORT=3000
SEARCH_INTERVAL_HOURS=3

# --- Datakilde: seats.aero (krever Pro-abonnement, API-nøkkel under Settings → API) ---
SEATSAERO_API_KEY=
SEATSAERO_SOURCE=eurobonus
# Skatter fra seats.aero oppgis i minste enhet (øre/cent). Sett til 1 hvis beløpene ser 100 ganger for små ut.
SEATSAERO_TAX_DIVISOR=100

# --- E-post (f.eks. Gmail med app-passord: smtp.gmail.com, port 465, SMTP_SECURE=true) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- SMS via Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Telegram (gratis). Lag en bot hos @BotFather og lim inn token ---
TELEGRAM_BOT_TOKEN=
